# Rename to .env


# API keys for literature search tools
# Fill in your actual keys below; this file is NOT committed to version control.

# NCBI (PubMed) — raises rate limit from 3 → 10 req/s
# Register at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=

# OpenAlex — no key needed; a contact email moves you into the faster "polite pool"
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=nish@gmail.com
